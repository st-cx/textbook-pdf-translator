* text=auto eol=lf
# Renderer/source identities bind exact bytes; preserve the accepted core snapshot
# on every checkout instead of silently changing its Windows line endings.
textbook_pdf/** -text whitespace=cr-at-eol,-blank-at-eof
# The published demo receipt also binds this generator's exact bytes.
examples/original-demo/build_demo.py -text whitespace=cr-at-eol,-blank-at-eof
tests/** text=auto eol=lf
tests/fixtures/*.ttf binary
*.pdf binary
*.png binary
*.bat text eol=crlf
